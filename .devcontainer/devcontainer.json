{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app_ui.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install -r requirements-lock.txt",
  "postAttachCommand": {
    "server": "python -m streamlit run app_ui.py --server.headless=true --server.address=0.0.0.0"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [
    8501
  ]
}
